# --- Telegram (opsiyonel) ---
# Tanimli degilse bildirim gonderilmez; panel ve tarama normal calisir.
# 1. Telegram'da @BotFather ile konus, /newbot yaz, bota isim ver
# 2. Sana verdigi token'i buraya yapistir
TELEGRAM_BOT_TOKEN=

# 3. Botunla konusmaya basla (/start yaz), sonra bu adresi ac:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    Cikan JSON'daki "chat":{"id":123456789} degerini buraya yaz
TELEGRAM_CHAT_ID=

# --- Claude API (analiz notlari icin) ---
# https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# --- TCMB EVDS (resmi istatistikler: kur, politika faizi, TUFE, rezervler) ---
# https://evds3.tcmb.gov.tr -> uyelik -> Profil -> API Anahtari (10 karakter)
# Not: anahtar `key` HTTP basliginda gonderilir; URL parametresi calismaz.
EVDS_API_KEY=

# Sessiz saatler (bu saatler arasinda sadece KRITIK bildirim gider) - Turkiye saati
SESSIZ_BASLANGIC=00
SESSIZ_BITIS=07
