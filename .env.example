# --- Telegram (zorunlu) ---
# 1. Telegram'da @BotFather ile konus, /newbot yaz, bota isim ver
# 2. Sana verdigi token'i buraya yapistir
TELEGRAM_BOT_TOKEN=

# 3. Botunla konusmaya basla (/start yaz), sonra bu adresi ac:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    Cikan JSON'daki "chat":{"id":123456789} degerini buraya yaz
TELEGRAM_CHAT_ID=

# --- Claude API (analiz notlari icin) ---
# https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# --- Opsiyonel ---
# TCMB EVDS API anahtari (enflasyon / politika faizi icin)
# https://evds2.tcmb.gov.tr adresinden ucretsiz kayit -> Profil -> API Anahtari
EVDS_API_KEY=

# Sessiz saatler (bu saatler arasinda sadece KRITIK bildirim gider) - Turkiye saati
SESSIZ_BASLANGIC=00
SESSIZ_BITIS=07
